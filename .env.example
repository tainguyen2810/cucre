# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# MySQL 8 – mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL="mysql://cucre:matkhau@localhost:3306/cucre"

# Auth.js – tạo bằng: npx auth secret  (hoặc: openssl rand -base64 32)
AUTH_SECRET=""

# URL công khai của site (dùng cho metadata, sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Thư mục lưu ảnh upload (nằm NGOÀI thư mục code; production do Nginx phục vụ qua /uploads/)
UPLOAD_DIR="./uploads"

# Tài khoản admin đầu tiên, dùng khi chạy seed
SEED_ADMIN_EMAIL="admin@cucre.vn"
SEED_ADMIN_PASSWORD=""

# Link Zalo OA hoặc nhóm Zalo cho nút "Nhận deal qua Zalo" (để trống thì nút trỏ về trang chủ)
NEXT_PUBLIC_ZALO_URL=""

# Cloudflare Turnstile chống spam form voucher/hợp tác (miễn phí, không bắt buộc). Để trống = tắt.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
